FROM auditold AS build
WORKDIR /app
ENV VITE_BYPASS_LOGIN=0 VITE_BYPASS_TUTORIAL=1 VITE_SERVER_URL=/api VITE_PVP_ENABLED=1 VITE_GITHUB_URL=https://github.com/aksmfosef11/pokerogue-streak-client VITE_WIKI_URL=https://wiki.pokerogue.net/start VITE_DISCORD_URL= VITE_REDDIT_URL= VITE_DONATE_URL=
RUN node node_modules/typescript/bin/tsc && node node_modules/vite/bin/vite.js build --config vite.pvp.config.ts
FROM nginx:alpine
COPY pvp.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/assets /usr/share/nginx/html
COPY --from=build /app/locales /usr/share/nginx/html/locales
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
